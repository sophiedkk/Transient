<?xml version="1.0" encoding="UTF-8"?>
<!-- Files bundled into the binary. Paths are looked up in crates/transient/resources/
     and in the build output directory (where the compiled Blueprint .ui files land).
     The prefix matches the app's resource base path (see src/config.rs). -->
<gresources>
  <gresource prefix="/io/github/sophiedkk/Transient/">
    <file preprocess="xml-stripblanks">ui/window.ui</file>
    <!-- Libadwaita loads style.css from the resource base path automatically. -->
    <file>style.css</file>
    <!-- Libadwaita loads this file automatically and adds the app.shortcuts action (Ctrl+?). -->
    <file alias="shortcuts-dialog.ui" preprocess="xml-stripblanks">ui/shortcuts-dialog.ui</file>
  </gresource>
</gresources>
