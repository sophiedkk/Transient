using Gtk 4.0;
using Adw 1;

translation-domain "transient";

// One track's header, to the left of its lane in the timeline. Its height must
// equal LANE_HEIGHT in src/widgets/timeline_view/mod.rs, so the two line up.
template $TransientTrackHeader: Box {
  orientation: vertical;
  spacing: 2;
  height-request: 96;

  styles [
    "track-header",
  ]

  Box {
    spacing: 2;

    Label name_label {
      hexpand: true;
      xalign: 0;
      ellipsize: end;

      styles [
        "heading",
      ]
    }

    ToggleButton mute_button {
      icon-name: "audio-volume-muted-symbolic";
      tooltip-text: _("Mute");
      valign: center;

      styles [
        "flat",
        "circular",
      ]
    }

    ToggleButton solo_button {
      icon-name: "audio-headphones-symbolic";
      tooltip-text: _("Solo");
      valign: center;

      styles [
        "flat",
        "circular",
      ]
    }
  }

  // Volume (wide) and pan (narrow) side by side, so the header fits in a lane.
  Box {
    spacing: 4;

    Scale volume_scale {
      hexpand: true;
      draw-value: false;

      adjustment: Adjustment {
        lower: -60;
        upper: 12;
        step-increment: 0.5;
        page-increment: 6;
      };

      accessibility {
        label: _("Volume");
      }
    }

    Scale pan_scale {
      width-request: 56;
      draw-value: false;

      adjustment: Adjustment {
        lower: -1;
        upper: 1;
        step-increment: 0.05;
        page-increment: 0.25;
      };

      accessibility {
        label: _("Pan");
      }
    }
  }
}
