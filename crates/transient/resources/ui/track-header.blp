using Gtk 4.0;
using Adw 1;

translation-domain "transient";

// One track's header, to the left of its lane in the timeline. Its height must
// equal LANE_HEIGHT in src/widgets/timeline_view/mod.rs, so the two line up.
template $TransientTrackHeader: Box {
  orientation: vertical;
  spacing: 2;
  height-request: 96;

  styles [
    "track-header",
  ]

  // The name, on its own row so it has the header's full width, or a text
  // field while renaming (double-click the name, Rename in the menu, or F2).
  Stack name_stack {
    hexpand: true;

    StackPage {
      name: "label";

      child: Label name_label {
        xalign: 0;
        ellipsize: end;

        styles [
          "heading",
        ]
      };
    }

    StackPage {
      name: "entry";

      child: Entry name_entry {
        width-chars: 6;

        accessibility {
          label: _("Track Name");
        }
      };
    }
  }

  // The track's buttons; the menu sits at the right end.
  Box {
    spacing: 2;

    // The icon shows the track's state (speaker, or crossed-out speaker when
    // muted), like the volume icons elsewhere in GNOME; see `update_tooltips`.
    ToggleButton mute_button {
      icon-name: "audio-volume-high-symbolic";
      tooltip-text: _("Mute");
      valign: center;

      styles [
        "flat",
        "circular",
        "mute-toggle",
      ]

      accessibility {
        label: _("Mute");
      }
    }

    ToggleButton solo_button {
      icon-name: "audio-headphones-symbolic";
      tooltip-text: _("Solo");
      valign: center;

      styles [
        "flat",
        "circular",
        "solo-toggle",
      ]

      accessibility {
        label: _("Solo");
      }
    }

    // Opens the track's effects, like Effects in the menu. Always there, so
    // people find the effects; in the accent colour while one is on (see
    // `TrackHeader::show_effects_on`).
    Button effects_button {
      icon-name: "transient-effects-symbolic";
      tooltip-text: _("Effects");
      action-name: "track.effects";
      valign: center;

      styles [
        "flat",
        "circular",
      ]

      accessibility {
        label: _("Effects");
      }
    }

    Box {
      hexpand: true;
    }

    // More track commands (for now Remove Track). The menu's actions are the
    // header's own ("track.…", see track_header.rs).
    MenuButton menu_button {
      icon-name: "view-more-symbolic";
      tooltip-text: _("Track Menu");
      menu-model: track_menu;
      valign: center;

      styles [
        "flat",
        "circular",
      ]

      accessibility {
        label: _("Track Menu");
      }
    }
  }

  // Volume (wide) and pan (narrow) side by side, so the header fits in a lane.
  Box {
    spacing: 4;

    Scale volume_scale {
      hexpand: true;
      draw-value: false;

      adjustment: Adjustment {
        lower: -60;
        upper: 12;
        step-increment: 0.5;
        page-increment: 6;
      };

      accessibility {
        label: _("Volume");
      }
    }

    Scale pan_scale {
      width-request: 56;
      draw-value: false;

      adjustment: Adjustment {
        lower: -1;
        upper: 1;
        step-increment: 0.05;
        page-increment: 0.25;
      };

      accessibility {
        label: _("Pan");
      }
    }
  }
}

menu track_menu {
  section {
    item {
      label: _("Re_name…");
      action: "track.rename";
    }

    item {
      label: _("Move _Up");
      action: "track.move-up";
    }

    item {
      label: _("Move _Down");
      action: "track.move-down";
    }
  }

  section {
    item {
      label: _("_Effects");
      action: "track.effects";
    }
  }

  // The colour circles (see TrackHeader::setup_color_picker).
  section {
    label: _("Color");

    item {
      custom: "colors";
    }
  }

  section {
    item {
      label: _("_Remove Track");
      action: "track.remove";
    }
  }
}
