using Gtk 4.0;
using Adw 1;

translation-domain "transient";

// The main window. `$TransientWindow` is the Rust type in src/window/imp.rs.
template $TransientWindow: Adw.ApplicationWindow {
  title: _("Transient");
  default-width: 1200;
  default-height: 720;
  // The smallest size the layout must work at. Breakpoints are added later.
  width-request: 640;
  height-request: 400;

  Adw.Breakpoint {
    condition ("max-width: 900sp")

    setters {
      split_view.collapsed: true;
    }
  }

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.ToolbarView toolbar_view {
      bottom-bar-style: raised;
      // The transport bar appears once a file is open.
      reveal-bottom-bars: false;

      [top]
      Adw.HeaderBar {
        // Shows the file name, with its format and length below it.
        title-widget: Adw.WindowTitle header_title {
          title: _("Transient");
        };

        [start]
        Button {
          icon-name: "list-add-symbolic";
          tooltip-text: _("Import Audio");
          action-name: "win.import-audio";
        }

        [start]
        Separator {
          styles [
            "spacer",
          ]
        }

        [start]
        Button {
          icon-name: "edit-undo-symbolic";
          tooltip-text: _("Undo");
          action-name: "win.undo";
        }

        [start]
        Button {
          icon-name: "edit-redo-symbolic";
          tooltip-text: _("Redo");
          action-name: "win.redo";
        }

        [end]
        MenuButton {
          primary: true;
          icon-name: "open-menu-symbolic";
          tooltip-text: _("Main Menu");
          menu-model: primary_menu;
        }

        [end]
        Button {
          icon-name: "document-send-symbolic";
          tooltip-text: _("Export");
          action-name: "win.export";
        }

        [end]
        ToggleButton pane_button {
          icon-name: "sidebar-show-right-symbolic";
          tooltip-text: _("Clip Properties");
          active: bind split_view.show-sidebar bidirectional;
        }
      }

      // Shown when a project's audio files cannot be found.
      [top]
      Adw.Banner missing_banner {
        revealed: false;
      }

      // One page is visible at a time; the code switches by name.
      // The clip pane (F9) is a utility pane on the right; on narrow windows it
      // slides over the timeline instead of beside it.
      content: Adw.OverlaySplitView split_view {
        sidebar-position: end;
        show-sidebar: false;
        max-sidebar-width: 320;

        sidebar: Adw.ViewStack pane_stack {
          Adw.ViewStackPage {
            name: "none";

            child: Adw.StatusPage {
              icon-name: "audio-x-generic-symbolic";
              title: _("No Clip Selected");
              description: _("Select a clip to change its gain and fades");

              styles [
                "compact",
              ]
            };
          }

          Adw.ViewStackPage {
            name: "clip";

            child: ScrolledWindow {
              hscrollbar-policy: never;

              child: Box {
                orientation: vertical;
                spacing: 24;
                margin-top: 18;
                margin-bottom: 18;
                margin-start: 12;
                margin-end: 12;

                Adw.PreferencesGroup pane_clip_group {
                  Adw.SpinRow gain_row {
                    title: _("Gain");
                    subtitle: _("In decibels");
                    digits: 1;

                    adjustment: Adjustment {
                      lower: -60;
                      upper: 24;
                      step-increment: 0.5;
                      page-increment: 6;
                    };
                  }

                  Adw.SpinRow fade_in_row {
                    title: _("Fade In");
                    subtitle: _("In seconds");
                    digits: 2;

                    adjustment: Adjustment {
                      lower: 0;
                      upper: 3600;
                      step-increment: 0.1;
                      page-increment: 1;
                    };
                  }

                  Adw.SpinRow fade_out_row {
                    title: _("Fade Out");
                    subtitle: _("In seconds");
                    digits: 2;

                    adjustment: Adjustment {
                      lower: 0;
                      upper: 3600;
                      step-increment: 0.1;
                      page-increment: 1;
                    };
                  }
                }

                Adw.PreferencesGroup {
                  Adw.ButtonRow {
                    title: _("Move to New Track");
                    action-name: "win.move-to-new-track";
                  }
                }

                Adw.PreferencesGroup {
                  title: _("Fades");

                  Adw.ButtonRow {
                    title: _("Fade In to Playhead");
                    action-name: "win.fade-in-to-playhead";
                  }

                  Adw.ButtonRow {
                    title: _("Fade Out from Playhead");
                    action-name: "win.fade-out-from-playhead";
                  }
                }

                Adw.PreferencesGroup {
                  title: _("Normalize");
                  description: _("Set the gain so the clip reaches a standard level");

                  Adw.ButtonRow {
                    title: _("Peak to −1 dB");
                    action-name: "win.normalize-peak";
                  }

                  Adw.ButtonRow {
                    title: _("Loudness to −16 LUFS");
                    action-name: "win.normalize-loudness";
                  }
                }
              };
            };
          }
        };

        content: Adw.ViewStack stack {
          // Before anything is imported.
          Adw.ViewStackPage {
            name: "empty";

            child: Adw.StatusPage {
              icon-name: "audio-x-generic-symbolic";
              title: _("Start a New Project");
              description: _("Import audio files to start mixing");

              child: Box {
                orientation: vertical;
                spacing: 12;
                halign: center;

                Button {
                  label: _("_Import Audio…");
                  use-underline: true;
                  action-name: "win.import-audio";

                  styles [
                    "pill",
                    "suggested-action",
                  ]
                }

                Button {
                  label: _("_Open Project…");
                  use-underline: true;
                  action-name: "win.open-project";

                  styles [
                    "pill",
                  ]
                }

                Box recent_group {
                  orientation: vertical;
                  spacing: 6;
                  margin-top: 24;
                  width-request: 360;
                  visible: false;

                  Label {
                    label: _("Recent Projects");
                    xalign: 0;

                    styles [
                      "heading",
                    ]
                  }

                  ListBox recent_list {
                    selection-mode: none;

                    styles [
                      "boxed-list",
                    ]
                  }
                }
              };
            };
          }

          // While a file is being decoded.
          Adw.ViewStackPage {
            name: "loading";

            child: Adw.StatusPage loading_page {
              child: Adw.Spinner {
                height-request: 48;
                width-request: 48;
              };
            };
          }

          // The project: track headers on the left, the timeline on the right. They
          // scroll vertically together; the horizontal scrollbar sits under the timeline.
          Adw.ViewStackPage {
            name: "project";

            child: Box {
              orientation: vertical;

              ScrolledWindow {
                vexpand: true;
                hscrollbar-policy: never;

                child: Box {
                  // The clamp keeps the headers 200 pixels wide: sliders would
                  // otherwise ask for much more. `hexpand: false` stops the volume
                  // sliders' hexpand from spreading up and widening the column.
                  Adw.Clamp headers_column {
                    hexpand: false;
                    maximum-size: 200;
                    tightening-threshold: 200;

                    child: Box {
                      orientation: vertical;
                      width-request: 200;

                      styles [
                        "track-headers",
                      ]

                      // Leaves room for the time ruler at the top of the timeline.
                      Box {
                        height-request: 28;
                      }

                      Box track_headers {
                        orientation: vertical;
                      }
                    };
                  }

                  Separator {
                    orientation: vertical;
                  }

                  $TransientTimelineView timeline {
                    hexpand: true;
                    vexpand: true;
                    adjustment: Adjustment view_adjustment {};

                    accessibility {
                      label: _("Timeline");
                    }
                  }
                };
              }

              Box {
                Box scrollbar_spacer {}

                Separator {
                  orientation: vertical;
                }

                Scrollbar {
                  hexpand: true;
                  orientation: horizontal;
                  adjustment: view_adjustment;
                }
              }
            };
          }
        };
      };

      [bottom]
      Box {
        spacing: 6;

        styles [
          "toolbar",
        ]

        Button {
          icon-name: "media-skip-backward-symbolic";
          tooltip-text: _("Go to Start");
          action-name: "win.go-to-start";
        }

        Button play_button {
          icon-name: "media-playback-start-symbolic";
          tooltip-text: _("Play");
          action-name: "win.play-pause";
        }

        Label position_label {
          label: "0:00.000";

          styles [
            "numeric",
          ]
        }

        Label duration_label {
          label: "/ 0:00.000";
          hexpand: true;
          xalign: 0;

          styles [
            "numeric",
            "dimmed",
          ]
        }

        // The output level: two thin bars (left and right) read as one meter.
        // Turns red when the mix clips, and is dimmed while nothing plays.
        Box level_meter {
          orientation: vertical;
          spacing: 2;
          valign: center;
          width-request: 120;
          tooltip-text: _("Output Level");

          styles [
            "level-meter",
            "dimmed",
          ]

          LevelBar left_meter {
            mode: continuous;
          }

          LevelBar right_meter {
            mode: continuous;
          }

          accessibility {
            label: _("Output Level");
          }
        }

        Image {
          icon-name: "audio-volume-high-symbolic";
          margin-start: 12;
        }

        Scale master_scale {
          width-request: 120;
          draw-value: false;
          tooltip-text: _("Master Volume");

          adjustment: Adjustment {
            lower: -60;
            upper: 12;
            step-increment: 0.5;
            page-increment: 6;
          };

          accessibility {
            label: _("Master Volume");
          }
        }

        Separator {
          styles [
            "spacer",
          ]
        }

        Button {
          icon-name: "zoom-out-symbolic";
          tooltip-text: _("Zoom Out");
          action-name: "win.zoom-out";
        }

        Button {
          icon-name: "zoom-fit-best-symbolic";
          tooltip-text: _("Zoom to Fit");
          action-name: "win.zoom-fit";
        }

        Button {
          icon-name: "zoom-in-symbolic";
          tooltip-text: _("Zoom In");
          action-name: "win.zoom-in";
        }
      }
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("_New Project");
      action: "win.new-project";
    }

    item {
      label: _("_Open Project…");
      action: "win.open-project";
    }

    item {
      label: _("_Save");
      action: "win.save";
    }

    item {
      label: _("Save _As…");
      action: "win.save-as";
    }

    item {
      label: _("_Export…");
      action: "win.export";
    }
  }

  section {
    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Transient");
      action: "app.about";
    }
  }
}

// Keeps the space under the track headers exactly as wide as the headers, so the
// scrollbar lines up with the timeline.
SizeGroup {
  mode: horizontal;

  widgets [
    headers_column,
    scrollbar_spacer,
  ]
}
