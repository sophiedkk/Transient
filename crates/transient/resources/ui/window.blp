using Gtk 4.0;
using Adw 1;

translation-domain "transient";

// The main window. `$TransientWindow` is the Rust type in src/window/imp.rs.
template $TransientWindow: Adw.ApplicationWindow {
  title: _("Transient");
  default-width: 1200;
  default-height: 720;
  // The smallest size the layout must work at. Breakpoints are added later.
  width-request: 640;
  height-request: 400;

  Adw.Breakpoint {
    condition ("max-width: 900sp")

    setters {
      split_view.collapsed: true;
    }
  }

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.ToolbarView toolbar_view {
      bottom-bar-style: raised;
      // The transport bar appears once a file is open.
      reveal-bottom-bars: false;

      [top]
      Adw.HeaderBar {
        // Shows the file name, with its format and length below it.
        title-widget: Adw.WindowTitle header_title {
          title: _("Transient");
        };

        [start]
        Button {
          icon-name: "list-add-symbolic";
          tooltip-text: _("Import Audio");
          action-name: "win.import-audio";

          accessibility {
            label: _("Import Audio");
          }
        }

        [start]
        Separator {
          styles [
            "spacer",
          ]
        }

        [start]
        Button {
          icon-name: "edit-undo-symbolic";
          tooltip-text: _("Undo");
          action-name: "win.undo";

          accessibility {
            label: _("Undo");
          }
        }

        [start]
        Button {
          icon-name: "edit-redo-symbolic";
          tooltip-text: _("Redo");
          action-name: "win.redo";

          accessibility {
            label: _("Redo");
          }
        }

        [end]
        MenuButton primary_menu_button {
          primary: true;
          icon-name: "open-menu-symbolic";
          tooltip-text: _("Main Menu");
          menu-model: primary_menu;

          accessibility {
            label: _("Main Menu");
          }
        }

        [end]
        Button {
          icon-name: "document-send-symbolic";
          tooltip-text: _("Export");
          action-name: "win.export";

          accessibility {
            label: _("Export");
          }
        }

        [end]
        ToggleButton pane_button {
          icon-name: "sidebar-show-right-symbolic";
          tooltip-text: _("Properties");
          active: bind split_view.show-sidebar bidirectional;

          accessibility {
            label: _("Properties");
          }
        }
      }

      // Shown when a project's audio files cannot be found.
      [top]
      // Locate… asks where the (first) missing file is now (window/missing.rs).
      Adw.Banner missing_banner {
        revealed: false;
        // The title can hold a file name; "&" or "<" in it is not markup.
        use-markup: false;
        button-label: _("_Locate…");
        action-name: "win.locate-missing";
      }

      // One page is visible at a time; the code switches by name.
      // The pane (F9) is a utility pane on the right; on narrow windows it
      // slides over the timeline instead of beside it.
      content: Adw.OverlaySplitView split_view {
        sidebar-position: end;
        show-sidebar: false;
        max-sidebar-width: 320;

        // Two tabs: the selected clip, and a track's effects. Each shows a
        // status page while there is nothing to show (see clip_pane.rs and
        // track_pane.rs).
        sidebar: Box {
          orientation: vertical;

          Adw.InlineViewSwitcher {
            stack: pane_tabs;
            homogeneous: true;
            margin-top: 12;
            margin-start: 12;
            margin-end: 12;
          }

          Adw.ViewStack pane_tabs {
            vexpand: true;

            Adw.ViewStackPage {
              name: "clip";
              title: _("Clip");

              child: Adw.ViewStack clip_stack {
                Adw.ViewStackPage {
                  name: "none";

                  child: Adw.StatusPage {
                    icon-name: "audio-x-generic-symbolic";
                    title: _("No Clip Selected");
                    description: _("Select a clip to change its gain and fades");

                    styles [
                      "compact",
                    ]
                  };
                }

                Adw.ViewStackPage {
                  name: "clip";

                  child: ScrolledWindow {
                    hscrollbar-policy: never;

                    child: Box {
                      orientation: vertical;
                      spacing: 24;
                      margin-top: 18;
                      margin-bottom: 18;
                      margin-start: 12;
                      margin-end: 12;

                      Adw.PreferencesGroup pane_clip_group {
                        Adw.SpinRow gain_row {
                          title: _("Gain");
                          subtitle: _("In decibels");
                          digits: 1;

                          adjustment: Adjustment {
                            lower: -60;
                            upper: 24;
                            step-increment: 0.5;
                            page-increment: 6;
                          };
                        }

                        Adw.SpinRow fade_in_row {
                          title: _("Fade In");
                          subtitle: _("In seconds");
                          digits: 2;

                          adjustment: Adjustment {
                            lower: 0;
                            upper: 3600;
                            step-increment: 0.1;
                            page-increment: 1;
                          };
                        }

                        Adw.SpinRow fade_out_row {
                          title: _("Fade Out");
                          subtitle: _("In seconds");
                          digits: 2;

                          adjustment: Adjustment {
                            lower: 0;
                            upper: 3600;
                            step-increment: 0.1;
                            page-increment: 1;
                          };
                        }
                      }

                      Adw.PreferencesGroup {
                        Adw.ButtonRow {
                          title: _("Move to New Track");
                          action-name: "win.move-to-new-track";
                        }
                      }

                      Adw.PreferencesGroup {
                        title: _("Fades");

                        Adw.ButtonRow {
                          title: _("Fade In to Playhead");
                          action-name: "win.fade-in-to-playhead";
                        }

                        Adw.ButtonRow {
                          title: _("Fade Out from Playhead");
                          action-name: "win.fade-out-from-playhead";
                        }
                      }

                      Adw.PreferencesGroup {
                        title: _("Normalize");
                        description: _("Set the gain so the clip reaches a standard level");

                        Adw.ButtonRow {
                          title: _("Peak to −1 dB");
                          action-name: "win.normalize-peak";
                        }

                        Adw.ButtonRow {
                          title: _("Loudness to −16 LUFS");
                          action-name: "win.normalize-loudness";
                        }
                      }
                    };
                  };
                }
              };
            }

            Adw.ViewStackPage {
              name: "track";
              title: _("Track");

              child: Adw.ViewStack track_stack {
                Adw.ViewStackPage {
                  name: "none";

                  child: Adw.StatusPage {
                    icon-name: "view-list-symbolic";
                    title: _("No Track Selected");
                    description: _("Select a clip, or choose Effects in a track’s menu, to change the track’s effects");

                    styles [
                      "compact",
                    ]
                  };
                }

                Adw.ViewStackPage {
                  name: "track";

                  child: ScrolledWindow {
                    hscrollbar-policy: never;

                    child: Box {
                      orientation: vertical;
                      spacing: 24;
                      margin-top: 18;
                      margin-bottom: 18;
                      margin-start: 12;
                      margin-end: 12;

                      // Only a heading: the track's name, set by the code.
                      Adw.PreferencesGroup pane_track_group {
                        description: _("Effects on this track, applied before its volume and pan");
                      }

                      // Each effect: a switch in the group's header, one slider in plain
                      // words with its value (src/widgets/effect_slider.rs), and one choice.
                      // The low cut's slider runs 0 to 1 on a logarithmic frequency scale
                      // (transient_core::effects::low_cut::frequency_for_amount); the others
                      // are in dBFS.
                      Adw.PreferencesGroup {
                        title: _("Low Cut");
                        description: _("Removes rumble and handling noise below voices and instruments");

                        header-suffix: Switch low_cut_switch {
                          valign: center;

                          accessibility {
                            label: _("Low Cut");
                          }
                        };

                        $TransientEffectSlider low_cut_slider {
                          title: _("Cut Below");
                          start-label: _("Rumble only");
                          end-label: _("Thin");
                          sensitive: bind low_cut_switch.active;

                          adjustment: Adjustment {
                            lower: 0;
                            upper: 1;
                            step-increment: 0.02;
                            page-increment: 0.1;
                          };
                        }

                        // The order matches transient_core::effects::low_cut::Slope (see track_pane.rs).
                        Adw.ComboRow low_cut_slope_row {
                          title: _("Slope");
                          sensitive: bind low_cut_switch.active;
                          // The choice shows below the title, where it has room.
                          use-subtitle: true;

                          model: StringList {
                            strings [
                              _("Gentle (12 dB per octave)"),
                              _("Medium (24 dB per octave)"),
                              _("Steep (48 dB per octave)"),
                            ]
                          };
                        }
                      }

                      Adw.PreferencesGroup {
                        title: _("Noise Gate");
                        description: _("Silences hiss and room noise between phrases");

                        header-suffix: Switch noise_gate_switch {
                          valign: center;

                          accessibility {
                            label: _("Noise Gate");
                          }
                        };

                        $TransientEffectSlider noise_gate_slider {
                          title: _("Quiet Below");
                          start-label: _("Only silence");
                          end-label: _("More");
                          sensitive: bind noise_gate_switch.active;
                          // Whole decibels, as the value beside it shows.
                          round-digits: 0;

                          adjustment: Adjustment {
                            lower: -80;
                            upper: -20;
                            step-increment: 1;
                            page-increment: 5;
                          };
                        }

                        // The order matches transient_core::effects::noise_gate::Reduction (see track_pane.rs).
                        Adw.ComboRow noise_gate_reduction_row {
                          title: _("Reduction");
                          sensitive: bind noise_gate_switch.active;
                          // The choice shows below the title, where it has room.
                          use-subtitle: true;

                          model: StringList {
                            strings [
                              _("Silence"),
                              _("Strong (−20 dB)"),
                              _("Light (−10 dB)"),
                            ]
                          };
                        }
                      }

                      // Three fixed bands, each −12 to +12 dB
                      // (transient_core::effects::equalizer).
                      Adw.PreferencesGroup {
                        title: _("Equalizer");
                        description: _("Shapes the tone: more or less bass, middle and treble");

                        header-suffix: Switch equalizer_switch {
                          valign: center;

                          accessibility {
                            label: _("Equalizer");
                          }
                        };

                        $TransientEffectSlider equalizer_bass_slider {
                          title: _("Bass");
                          start-label: _("Less");
                          end-label: _("More");
                          sensitive: bind equalizer_switch.active;
                          round-digits: 0;

                          adjustment: Adjustment {
                            lower: -12;
                            upper: 12;
                            step-increment: 1;
                            page-increment: 3;
                          };
                        }

                        $TransientEffectSlider equalizer_middle_slider {
                          title: _("Middle");
                          start-label: _("Less");
                          end-label: _("More");
                          sensitive: bind equalizer_switch.active;
                          round-digits: 0;

                          adjustment: Adjustment {
                            lower: -12;
                            upper: 12;
                            step-increment: 1;
                            page-increment: 3;
                          };
                        }

                        $TransientEffectSlider equalizer_treble_slider {
                          title: _("Treble");
                          start-label: _("Less");
                          end-label: _("More");
                          sensitive: bind equalizer_switch.active;
                          round-digits: 0;

                          adjustment: Adjustment {
                            lower: -12;
                            upper: 12;
                            step-increment: 1;
                            page-increment: 3;
                          };
                        }
                      }

                      Adw.PreferencesGroup {
                        title: _("Compressor");
                        description: _("Evens out the volume: loud parts down, then the whole track up");

                        header-suffix: Switch compressor_switch {
                          valign: center;

                          accessibility {
                            label: _("Compressor");
                          }
                        };

                        $TransientEffectSlider compressor_slider {
                          title: _("Compress Above");
                          start-label: _("Almost all");
                          end-label: _("Only peaks");
                          sensitive: bind compressor_switch.active;
                          round-digits: 0;

                          adjustment: Adjustment {
                            lower: -40;
                            upper: 0;
                            step-increment: 1;
                            page-increment: 5;
                          };
                        }

                        // The order matches transient_core::effects::compressor::Ratio (see track_pane.rs).
                        Adw.ComboRow compressor_ratio_row {
                          title: _("Ratio");
                          sensitive: bind compressor_switch.active;
                          // The choice shows below the title, where it has room.
                          use-subtitle: true;

                          model: StringList {
                            strings [
                              _("Gentle (2:1)"),
                              _("Medium (4:1)"),
                              _("Strong (8:1)"),
                            ]
                          };
                        }
                      }
                    };
                  };
                }
              };
            }
          }
        };

        content: Adw.ViewStack stack {
          // Before anything is imported.
          Adw.ViewStackPage {
            name: "empty";

            // The icon is the app icon, set in code: its name is the app ID,
            // which differs for development builds.
            child: Adw.StatusPage start_page {
              title: _("Start a New Project");
              description: _("Import or record audio to start");

              child: Box {
                orientation: vertical;
                spacing: 12;
                halign: center;

                Button {
                  label: _("_Import Audio…");
                  use-underline: true;
                  action-name: "win.import-audio";

                  styles [
                    "pill",
                    "suggested-action",
                  ]
                }

                Button {
                  label: _("_Record Audio");
                  use-underline: true;
                  action-name: "win.record";

                  styles [
                    "pill",
                  ]
                }

                Button {
                  label: _("_Open Project…");
                  use-underline: true;
                  action-name: "win.open-project";

                  styles [
                    "pill",
                  ]
                }

                Box recent_group {
                  orientation: vertical;
                  spacing: 6;
                  margin-top: 24;
                  width-request: 360;
                  visible: false;

                  Label {
                    label: _("Recent Projects");
                    xalign: 0;

                    styles [
                      "heading",
                    ]
                  }

                  ListBox recent_list {
                    selection-mode: none;

                    styles [
                      "boxed-list",
                    ]
                  }
                }
              };
            };
          }

          // While a file is being decoded.
          Adw.ViewStackPage {
            name: "loading";

            child: Adw.StatusPage loading_page {
              child: Adw.Spinner {
                height-request: 48;
                width-request: 48;
              };
            };
          }

          // The project: track headers on the left, the timeline on the right. They
          // scroll vertically together; the horizontal scrollbar sits under the timeline.
          Adw.ViewStackPage {
            name: "project";

            child: Box {
              orientation: vertical;

              ScrolledWindow {
                vexpand: true;
                hscrollbar-policy: never;

                child: Box {
                  // The clamp keeps the headers 200 pixels wide: sliders would
                  // otherwise ask for much more. `hexpand: false` stops the volume
                  // sliders' hexpand from spreading up and widening the column.
                  Adw.Clamp headers_column {
                    hexpand: false;
                    maximum-size: 200;
                    tightening-threshold: 200;

                    child: Box {
                      orientation: vertical;
                      width-request: 200;

                      styles [
                        "track-headers",
                      ]

                      // Leaves room for the time ruler at the top of the timeline.
                      Box {
                        height-request: 28;
                      }

                      // The drop target for dragged headers (window/track_order.rs).
                      Box track_headers {
                        orientation: vertical;

                        styles [
                          "track-header-list",
                        ]
                      }
                    };
                  }

                  Separator {
                    orientation: vertical;
                  }

                  $TransientTimelineView timeline {
                    hexpand: true;
                    vexpand: true;
                    adjustment: Adjustment view_adjustment {};

                    accessibility {
                      label: _("Timeline");
                    }
                  }
                };
              }

              Box {
                Box scrollbar_spacer {}

                Separator {
                  orientation: vertical;
                }

                Scrollbar {
                  hexpand: true;
                  orientation: horizontal;
                  adjustment: view_adjustment;
                }
              }
            };
          }
        };
      };

      [bottom]
      Box {
        spacing: 6;

        styles [
          "toolbar",
        ]

        Button {
          icon-name: "media-skip-backward-symbolic";
          tooltip-text: _("Go to Start");
          action-name: "win.go-to-start";

          accessibility {
            label: _("Go to Start");
          }
        }

        Button play_button {
          icon-name: "media-playback-start-symbolic";
          tooltip-text: _("Play");
          action-name: "win.play-pause";

          accessibility {
            label: _("Play");
          }
        }

        // Turns into a red Stop button while recording; its arrow chooses the
        // input (see recording.rs).
        Adw.SplitButton record_button {
          icon-name: "media-record-symbolic";
          tooltip-text: _("Record");
          dropdown-tooltip: _("Choose Input");
          action-name: "win.record";

          styles [
            "record-button",
          ]

          accessibility {
            label: _("Record");
          }
        }

        Label position_label {
          label: "0:00.000";

          styles [
            "numeric",
          ]
        }

        Label duration_label {
          label: "/ 0:00.000";
          xalign: 0;

          styles [
            "numeric",
            "dimmed",
          ]
        }

        // Editing buttons, for people who do not know the shortcuts. Their
        // tooltips change with the selection (see `update_edit_actions`).
        Box {
          spacing: 6;
          margin-start: 12;
          hexpand: true;

          Button split_button {
            icon-name: "transient-split-symbolic";
            tooltip-text: _("Split at Playhead");
            action-name: "win.split";

            accessibility {
              label: _("Split at Playhead");
            }
          }

          Button delete_button {
            icon-name: "user-trash-symbolic";
            tooltip-text: _("Delete");
            action-name: "win.delete-clip";

            accessibility {
              label: _("Delete");
            }
          }

          // The time selection's start, end and length (see selection.rs).
          Label selection_label {
            visible: false;
            margin-start: 6;
            tooltip-text: _("Time Selection");

            styles [
              "numeric",
              "dimmed",
            ]
          }
        }

        // The output level: two thin bars (left and right) read as one meter.
        // Turns red when the mix clips, and is dimmed while nothing plays.
        Box level_meter {
          orientation: vertical;
          spacing: 2;
          valign: center;
          width-request: 120;
          tooltip-text: _("Output Level");

          styles [
            "level-meter",
            "dimmed",
          ]

          LevelBar left_meter {
            mode: continuous;
          }

          LevelBar right_meter {
            mode: continuous;
          }

          accessibility {
            label: _("Output Level");
          }
        }

        Image {
          icon-name: "audio-volume-high-symbolic";
          margin-start: 12;
        }

        Scale master_scale {
          width-request: 120;
          draw-value: false;
          tooltip-text: _("Master Volume");

          adjustment: Adjustment {
            lower: -60;
            upper: 12;
            step-increment: 0.5;
            page-increment: 6;
          };

          accessibility {
            label: _("Master Volume");
          }
        }

        // The master limiter: keeps the whole mix under −1 dBFS. Coloured
        // while on, like the track header toggles (see mixer.rs).
        ToggleButton limiter_button {
          icon-name: "transient-limiter-symbolic";
          tooltip-text: _("Prevent Clipping");
          valign: center;

          styles [
            "flat",
            "circular",
            "limiter-toggle",
          ]

          accessibility {
            label: _("Prevent Clipping");
          }
        }

        Separator {
          styles [
            "spacer",
          ]
        }

        Button {
          icon-name: "zoom-out-symbolic";
          tooltip-text: _("Zoom Out");
          action-name: "win.zoom-out";

          accessibility {
            label: _("Zoom Out");
          }
        }

        Button {
          icon-name: "zoom-fit-best-symbolic";
          tooltip-text: _("Zoom to Fit");
          action-name: "win.zoom-fit";

          accessibility {
            label: _("Zoom to Fit");
          }
        }

        Button {
          icon-name: "zoom-in-symbolic";
          tooltip-text: _("Zoom In");
          action-name: "win.zoom-in";

          accessibility {
            label: _("Zoom In");
          }
        }
      }
    };
  };
}

menu primary_menu {
  // Follow system, light or dark style (see window/style.rs).
  section {
    item {
      custom: "style";
    }
  }

  section {
    item {
      label: _("_New Project");
      action: "win.new-project";
    }

    item {
      label: _("_Open Project…");
      action: "win.open-project";
    }

    item {
      label: _("_Save");
      action: "win.save";
    }

    item {
      label: _("Save _As…");
      action: "win.save-as";
    }

    item {
      label: _("_Export…");
      action: "win.export";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "win.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Transient");
      action: "app.about";
    }
  }
}

// Keeps the space under the track headers exactly as wide as the headers, so the
// scrollbar lines up with the timeline.
SizeGroup {
  mode: horizontal;

  widgets [
    headers_column,
    scrollbar_spacer,
  ]
}

// The timeline's context menu (right-click, long press, Menu key). GTK shows
// each item's keyboard shortcut next to it.
menu timeline_menu {
  section {
    item {
      label: _("Cu_t");
      action: "win.cut";
      accel: "<Control>x";
    }

    item {
      label: _("_Copy");
      action: "win.copy";
      accel: "<Control>c";
    }

    item {
      label: _("_Paste");
      action: "win.paste";
      accel: "<Control>v";
    }

    item {
      label: _("Paste and _Make Room");
      action: "win.paste-insert";
      accel: "<Shift><Control>v";
    }
  }

  section {
    item {
      label: _("_Split");
      action: "win.split";
      accel: "s";
    }

    item {
      label: _("_Delete");
      action: "win.delete-clip";
      accel: "Delete";
    }

    item {
      label: _("Delete and Close _Gap");
      action: "win.ripple-delete";
      accel: "<Control>Delete";
    }
  }

  section {
    item {
      label: _("Move to _New Track");
      action: "win.move-to-new-track";
    }
  }

  section {
    item {
      label: _("Select _All");
      action: "win.select-all";
      accel: "<Control>a";
    }
  }
}
