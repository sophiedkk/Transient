using Gtk 4.0;
using Adw 1;

translation-domain "transient";

// Libadwaita shows this dialog for the app.shortcuts action (Ctrl+?).
// The object id must be `shortcuts_dialog`. Keep this list in sync with
// the accelerators set in src/application.rs.
Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: _("Playback");

    Adw.ShortcutsItem {
      title: _("Play or Pause");
      action-name: "win.play-pause";
    }

    Adw.ShortcutsItem {
      title: _("Go to Start");
      action-name: "win.go-to-start";
    }
  }

  Adw.ShortcutsSection {
    title: _("Editing");

    Adw.ShortcutsItem {
      title: _("Undo");
      action-name: "win.undo";
    }

    Adw.ShortcutsItem {
      title: _("Redo");
      action-name: "win.redo";
    }

    Adw.ShortcutsItem {
      title: _("Split at Playhead");
      action-name: "win.split";
    }

    Adw.ShortcutsItem {
      title: _("Delete Clip");
      action-name: "win.delete-clip";
    }

    Adw.ShortcutsItem {
      title: _("Move Clip Left");
      action-name: "win.nudge-left";
    }

    Adw.ShortcutsItem {
      title: _("Move Clip Right");
      action-name: "win.nudge-right";
    }

    Adw.ShortcutsItem {
      title: _("Deselect");
      action-name: "win.deselect";
    }
  }

  Adw.ShortcutsSection {
    title: _("Mixing");

    Adw.ShortcutsItem {
      title: _("Mute Track of Selected Clip");
      action-name: "win.toggle-mute";
    }

    Adw.ShortcutsItem {
      title: _("Solo Track of Selected Clip");
      action-name: "win.toggle-solo";
    }
  }

  Adw.ShortcutsSection {
    title: _("View");

    Adw.ShortcutsItem {
      title: _("Zoom In");
      action-name: "win.zoom-in";
    }

    Adw.ShortcutsItem {
      title: _("Zoom Out");
      action-name: "win.zoom-out";
    }

    Adw.ShortcutsItem {
      title: _("Zoom to Fit");
      action-name: "win.zoom-fit";
    }
  }

  Adw.ShortcutsSection {
    title: _("General");

    Adw.ShortcutsItem {
      title: _("Import Audio");
      action-name: "win.import-audio";
    }

    Adw.ShortcutsItem {
      title: _("Show Shortcuts");
      action-name: "app.shortcuts";
    }

    Adw.ShortcutsItem {
      title: _("Close Window");
      action-name: "window.close";
    }

    Adw.ShortcutsItem {
      title: _("Quit");
      action-name: "app.quit";
    }
  }
}
