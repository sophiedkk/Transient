using Gtk 4.0;
using Adw 1;

translation-domain "transient";

// Libadwaita shows this dialog for the app.shortcuts action (Ctrl+?).
// The object id must be `shortcuts_dialog`. Keep this list in sync with
// the accelerators set in src/application.rs.
Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: _("Playback");

    Adw.ShortcutsItem {
      title: _("Play or Pause");
      action-name: "win.play-pause";
    }

    Adw.ShortcutsItem {
      title: _("Go to Start");
      action-name: "win.go-to-start";
    }
  }

  Adw.ShortcutsSection {
    title: _("Editing");

    Adw.ShortcutsItem {
      title: _("Undo");
      action-name: "win.undo";
    }

    Adw.ShortcutsItem {
      title: _("Redo");
      action-name: "win.redo";
    }

    Adw.ShortcutsItem {
      title: _("Split at Playhead or Selection");
      action-name: "win.split";
    }

    Adw.ShortcutsItem {
      title: _("Delete Clip or Selection");
      action-name: "win.delete-clip";
    }

    Adw.ShortcutsItem {
      title: _("Delete and Close Gap");
      action-name: "win.ripple-delete";
    }

    Adw.ShortcutsItem {
      title: _("Select All");
      action-name: "win.select-all";
    }

    Adw.ShortcutsItem {
      title: _("Move Clip Left");
      action-name: "win.nudge-left";
    }

    Adw.ShortcutsItem {
      title: _("Move Clip Right");
      action-name: "win.nudge-right";
    }

    Adw.ShortcutsItem {
      title: _("Deselect");
      action-name: "win.deselect";
    }

    Adw.ShortcutsItem {
      title: _("Show Context Menu");
      action-name: "win.context-menu";
    }
  }

  Adw.ShortcutsSection {
    title: _("Tracks");

    Adw.ShortcutsItem {
      title: _("Rename Track");
      action-name: "win.rename-track";
    }

    Adw.ShortcutsItem {
      title: _("Move Track Up");
      action-name: "win.move-track-up";
    }

    Adw.ShortcutsItem {
      title: _("Move Track Down");
      action-name: "win.move-track-down";
    }
  }

  Adw.ShortcutsSection {
    title: _("Mixing");

    Adw.ShortcutsItem {
      title: _("Mute Track of Selected Clip");
      action-name: "win.toggle-mute";
    }

    Adw.ShortcutsItem {
      title: _("Solo Track of Selected Clip");
      action-name: "win.toggle-solo";
    }
  }

  Adw.ShortcutsSection {
    title: _("View");

    Adw.ShortcutsItem {
      title: _("Show Clip Properties");
      action-name: "win.toggle-clip-pane";
    }

    Adw.ShortcutsItem {
      title: _("Zoom In");
      action-name: "win.zoom-in";
    }

    Adw.ShortcutsItem {
      title: _("Zoom Out");
      action-name: "win.zoom-out";
    }

    Adw.ShortcutsItem {
      title: _("Zoom to Fit");
      action-name: "win.zoom-fit";
    }
  }

  Adw.ShortcutsSection {
    title: _("General");

    Adw.ShortcutsItem {
      title: _("New Project");
      action-name: "win.new-project";
    }

    Adw.ShortcutsItem {
      title: _("Open Project");
      action-name: "win.open-project";
    }

    Adw.ShortcutsItem {
      title: _("Save");
      action-name: "win.save";
    }

    Adw.ShortcutsItem {
      title: _("Save As");
      action-name: "win.save-as";
    }

    Adw.ShortcutsItem {
      title: _("Export");
      action-name: "win.export";
    }

    Adw.ShortcutsItem {
      title: _("Import Audio");
      action-name: "win.import-audio";
    }

    Adw.ShortcutsItem {
      title: _("Show Shortcuts");
      action-name: "app.shortcuts";
    }

    Adw.ShortcutsItem {
      title: _("Close Window");
      action-name: "window.close";
    }

    Adw.ShortcutsItem {
      title: _("Quit");
      action-name: "app.quit";
    }
  }
}
