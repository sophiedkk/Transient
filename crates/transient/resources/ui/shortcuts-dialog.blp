using Gtk 4.0;
using Adw 1;

translation-domain "transient";

// Libadwaita shows this dialog for the app.shortcuts action (Ctrl+?).
// The object id must be `shortcuts_dialog`. Keep this list in sync with
// the accelerators set in src/application.rs and src/window/shortcuts.rs.
Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: _("Playback");

    Adw.ShortcutsItem {
      title: _("Play or Pause");
      accelerator: "space";
    }

    Adw.ShortcutsItem {
      title: _("Record or Stop Recording");
      accelerator: "r";
    }

    Adw.ShortcutsItem {
      title: _("Go to Start");
      accelerator: "Home";
    }
  }

  Adw.ShortcutsSection {
    title: _("Editing");

    Adw.ShortcutsItem {
      title: _("Undo");
      accelerator: "<Control>z";
    }

    Adw.ShortcutsItem {
      title: _("Redo");
      accelerator: "<Shift><Control>z";
    }

    Adw.ShortcutsItem {
      title: _("Split at Playhead or Selection");
      accelerator: "s";
    }

    Adw.ShortcutsItem {
      title: _("Delete Clip or Selection");
      accelerator: "Delete";
    }

    Adw.ShortcutsItem {
      title: _("Delete and Close Gap");
      accelerator: "<Control>Delete";
    }

    Adw.ShortcutsItem {
      title: _("Select All");
      accelerator: "<Control>a";
    }

    Adw.ShortcutsItem {
      title: _("Cut");
      accelerator: "<Control>x";
    }

    Adw.ShortcutsItem {
      title: _("Copy");
      accelerator: "<Control>c";
    }

    Adw.ShortcutsItem {
      title: _("Paste");
      accelerator: "<Control>v";
    }

    Adw.ShortcutsItem {
      title: _("Paste and Make Room");
      accelerator: "<Shift><Control>v";
    }

    Adw.ShortcutsItem {
      title: _("Move Clip Left");
      accelerator: "<Control>Left";
    }

    Adw.ShortcutsItem {
      title: _("Move Clip Right");
      accelerator: "<Control>Right";
    }

    Adw.ShortcutsItem {
      title: _("Deselect");
      accelerator: "Escape";
    }

    Adw.ShortcutsItem {
      title: _("Show Context Menu");
      accelerator: "Menu <Shift>F10";
    }
  }

  Adw.ShortcutsSection {
    title: _("Timeline");

    Adw.ShortcutsItem {
      title: _("Move Playhead");
      accelerator: "Left Right";
    }

    Adw.ShortcutsItem {
      title: _("Select Time");
      accelerator: "<Shift>Left <Shift>Right";
    }

    Adw.ShortcutsItem {
      title: _("Previous or Next Track");
      accelerator: "Up Down";
    }

    Adw.ShortcutsItem {
      title: _("Go to End");
      accelerator: "End";
    }
  }

  Adw.ShortcutsSection {
    title: _("Tracks");

    Adw.ShortcutsItem {
      title: _("Rename Track");
      action-name: "win.rename-track";
    }

    Adw.ShortcutsItem {
      title: _("Move Track Up");
      accelerator: "<Alt>Up";
    }

    Adw.ShortcutsItem {
      title: _("Move Track Down");
      accelerator: "<Alt>Down";
    }
  }

  Adw.ShortcutsSection {
    title: _("Mixing");

    Adw.ShortcutsItem {
      title: _("Mute Track of Selected Clip");
      accelerator: "m";
    }

    Adw.ShortcutsItem {
      title: _("Solo Track of Selected Clip");
      accelerator: "<Shift>m";
    }
  }

  Adw.ShortcutsSection {
    title: _("View");

    Adw.ShortcutsItem {
      title: _("Show Properties");
      action-name: "win.toggle-clip-pane";
    }

    Adw.ShortcutsItem {
      title: _("Zoom In");
      action-name: "win.zoom-in";
    }

    Adw.ShortcutsItem {
      title: _("Zoom Out");
      action-name: "win.zoom-out";
    }

    Adw.ShortcutsItem {
      title: _("Zoom to Fit");
      action-name: "win.zoom-fit";
    }
  }

  Adw.ShortcutsSection {
    title: _("General");

    Adw.ShortcutsItem {
      title: _("New Project");
      action-name: "win.new-project";
    }

    Adw.ShortcutsItem {
      title: _("Open Project");
      action-name: "win.open-project";
    }

    Adw.ShortcutsItem {
      title: _("Save");
      action-name: "win.save";
    }

    Adw.ShortcutsItem {
      title: _("Save As");
      action-name: "win.save-as";
    }

    Adw.ShortcutsItem {
      title: _("Export");
      action-name: "win.export";
    }

    Adw.ShortcutsItem {
      title: _("Import Audio");
      action-name: "win.import-audio";
    }

    Adw.ShortcutsItem {
      title: _("Preferences");
      action-name: "win.preferences";
    }

    Adw.ShortcutsItem {
      title: _("Show Shortcuts");
      action-name: "app.shortcuts";
    }

    Adw.ShortcutsItem {
      title: _("Close Window");
      action-name: "window.close";
    }

    Adw.ShortcutsItem {
      title: _("Quit");
      action-name: "app.quit";
    }
  }
}
