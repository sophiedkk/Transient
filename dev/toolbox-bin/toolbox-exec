#!/usr/bin/env bash
# Runs a Rust tool (cargo, rustc, …) inside the transient-dev toolbox, where GTK,
# GStreamer, Blueprint and the pinned Rust toolchain are installed (see
# dev/Containerfile). The tool is named after this script's link name:
# dev/toolbox-bin/cargo runs the image's cargo.
#
# RustRover runs on the desktop and uses this folder as its Rust toolchain
# (Settings → Rust → Toolchain location), so builds happen in the toolbox.
# The home folder is the same inside and outside, so paths work both ways.
set -euo pipefail

tool="$(basename "$0")"
container="transient-dev"
# Where the image keeps Rust (not ~/.cargo, which belongs to the desktop).
rust_env=(RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo)
binary="/usr/local/cargo/bin/$tool"

# Already inside a toolbox: run the tool directly.
if [ -f /run/.toolboxenv ]; then
    exec env "${rust_env[@]}" "$binary" "$@"
fi

# toolbox run does not pass on environment variables; RustRover sets some for
# Cargo (RUSTC_BOOTSTRAP, CARGO_TERM_COLOR, …), so forward Cargo's and Rust's.
# They come after rust_env, so RustRover's own choices win.
forwarded=()
while IFS='=' read -r name _; do
    case "$name" in
        CARGO* | RUST* | TERM | GSETTINGS_SCHEMA_DIR) forwarded+=("$name=${!name}") ;;
    esac
done < <(env)

exec toolbox run --container "$container" \
    env "${rust_env[@]}" "${forwarded[@]}" "$binary" "$@"
