#!/usr/bin/env bash
# Removes AI-assistant attribution lines from commit messages (project rule:
# commits describe the change only). Enabled by dev/setup.sh via core.hooksPath.
set -euo pipefail

message_file="$1"
[ -f "$message_file" ] || exit 0

grep -viE \
    -e '^[[:space:]]*Co-authored-by:.*(claude|anthropic|\[bot\])' \
    -e '^[[:space:]]*(Assisted|Signed-off)-by:.*claude' \
    -e '(generated|written) (with|by) .*claude' \
    -e 'claude code' \
    -e '🤖' \
    "$message_file" > "$message_file.tmp" || true
mv "$message_file.tmp" "$message_file"
