<?xml version="1.0" encoding="UTF-8"?>
<!-- Settings stored with GSettings (dconf). Shared by stable and development builds. -->
<schemalist gettext-domain="transient">
  <schema id="io.github.sophiedkk.Transient" path="/io/github/sophiedkk/Transient/">
    <key name="window-width" type="i">
      <default>1200</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>720</default>
      <summary>Window height</summary>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Window maximized</summary>
    </key>
    <key name="color-scheme" type="s">
      <choices>
        <choice value="default"/>
        <choice value="light"/>
        <choice value="dark"/>
      </choices>
      <default>'default'</default>
      <summary>Style</summary>
      <description>Light or dark style; "default" follows the system.</description>
    </key>
    <key name="recording-offset" type="i">
      <range min="-1000" max="1000"/>
      <default>0</default>
      <summary>Recording offset</summary>
      <description>Milliseconds added to where recordings are placed, on top of the measured delay; negative moves them earlier.</description>
    </key>
    <key name="record-input" type="s">
      <default>''</default>
      <summary>Recording input</summary>
      <description>The input to record from; empty means the system default.</description>
    </key>
    <key name="export-format" type="s">
      <choices>
        <choice value="wav"/>
        <choice value="flac"/>
        <choice value="mp3"/>
        <choice value="opus"/>
        <choice value="ogg"/>
      </choices>
      <default>'wav'</default>
      <summary>Export format</summary>
      <description>The format the Export dialog starts with, by file extension; the last format exported to.</description>
    </key>
    <key name="export-quality" type="u">
      <default>0</default>
      <summary>Export quality</summary>
      <description>The quality the Export dialog starts with: bits per sample for WAV and FLAC, kbit/s for the others; 0 means the format's usual quality.</description>
    </key>
  </schema>
</schemalist>
