<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata: https://www.freedesktop.org/software/appstream/docs/ -->
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>Transient</name>
  <summary>Mix and trim audio files</summary>
  <description>
    <p>
      Transient is a simple multitrack audio editor. Put audio files on tracks,
      trim and arrange them, record over them, balance their volume, and export
      the mix.
    </p>
    <ul>
      <li>Arrange, trim, split and cut clips on tracks, with undo for every change</li>
      <li>Fades, clip gain and normalizing</li>
      <li>Volume, pan, mute and solo for every track</li>
      <li>Record from a microphone while the other tracks play</li>
      <li>Export to WAV, FLAC, MP3, Opus or Ogg Vorbis</li>
    </ul>
    <p>
      Transient is in early development: expect rough edges.
    </p>
  </description>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/sophiedkk/Transient/main/data/screenshots/main-window.png</image>
      <caption>Four coloured tracks with fades, and a selected clip</caption>
    </screenshot>
  </screenshots>

  <developer id="io.github.sophiedkk">
    <name>Sophie de Klerk</name>
  </developer>

  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <translation type="gettext">transient</translation>

  <url type="homepage">https://github.com/sophiedkk/Transient</url>
  <url type="bugtracker">https://github.com/sophiedkk/Transient/issues</url>
  <url type="vcs-browser">https://github.com/sophiedkk/Transient</url>

  <!-- OARS: an empty rating means "none" for every kind of content (no
       violence, no in-app purchases, no chat, no data sharing, …), which is
       true for Transient. https://hughsie.github.io/oars/ -->
  <content_rating type="oars-1.1" />

  <requires>
    <display_length compare="ge">640</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>

  <!-- Brand colours (the banner behind the icon in GNOME Software and on
       Flathub), from the trans flag like the icon: its pink in light mode, a
       deep version of its light blue in dark mode. Both stand out from the
       icon's dark plate, and white text stays readable on the dark one. -->
  <branding>
    <color type="primary" scheme_preference="light">#f5a9b8</color>
    <color type="primary" scheme_preference="dark">#1f6f94</color>
  </branding>

  <releases>
    <release version="0.2.0" date="2026-11-05">
      <description>
        <p>Track colours, a light or dark style of your own, and smoother editing.</p>
        <ul>
          <li>Give tracks one of nine colours</li>
          <li>Choose a light, dark or system style in the main menu</li>
          <li>Double-click a clip to open its properties</li>
          <li>Remove projects from the recent list</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-11-04">
      <description>
        <p>The first release of Transient: a simple multitrack audio editor.</p>
        <ul>
          <li>Import, arrange, trim, split and cut audio on tracks, with undo</li>
          <li>Time selections, ripple delete, cut, copy and paste</li>
          <li>Fades, clip gain, normalizing, and a mixer with volume, pan, mute and solo</li>
          <li>Record from a microphone while the other tracks play</li>
          <li>Project files that hold their audio, and export to WAV, FLAC, MP3, Opus and Ogg Vorbis</li>
          <li>Works with the keyboard, touchpad gestures and screen readers</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
